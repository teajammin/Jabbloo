{
  "name": "jabbloo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Whimsical creative multiplayer fighting game",
  "scripts": {
    "dev": "concurrently -n web,api,party -c cyan,magenta,yellow \"vite\" \"npm:dev:server\" \"npm:dev:party\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:placeholders": "node scripts/generate-placeholders.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "test": "esbuild test/parse.test.ts test/protocol.test.ts --bundle --platform=node --format=esm --outdir=node_modules/.cache/tests --out-extension:.js=.mjs --log-level=error && node node_modules/.cache/tests/parse.test.mjs && node node_modules/.cache/tests/protocol.test.mjs",
    "dev:party": "partykit dev",
    "test:room": "node test/room.test.mjs",
    "gen:letters": "node scripts/generate-letters.mjs",
    "gen:effects": "node scripts/generate-effects.mjs",
    "gen:sheet": "node scripts/letters-tracing-sheet.mjs",
    "test:creation": "node test/creation.test.mjs",
    "test:battleground": "node test/battleground.test.mjs",
    "test:battle": "node test/battle.test.mjs",
    "test:turns": "node test/turns.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "gsap": "^3.12.5",
    "partysocket": "^1.3.0",
    "pixi.js": "^7.4.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "partykit": "^0.0.115",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
