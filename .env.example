# Copy this file to .env.local and fill in real values.
#
# Both .env and .env.local are gitignored — never commit real keys. Keys belong
# in .env.local specifically: PartyKit reads .env when deploying the multiplayer
# room, which needs no keys at all, so anything secret stays out of that file.
# Non-secret settings (models, port) can live in either.

# Anthropic API key for the AI choreographer.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-me

# Model used to turn player prompts into choreography JSON.
CHOREOGRAPHER_MODEL=claude-haiku-4-5

# Fallback when the primary model fails or returns unusable output.
CHOREOGRAPHER_FALLBACK_MODEL=claude-sonnet-5

# Port for the Express backend.
PORT=8787

# Remove.bg API key, for cutting subjects out of uploaded photos.
# Get one at https://www.remove.bg/dashboard#api-key
# Optional: without it, uploads fall back to a local edge-flood cutout.
REMOVEBG_API_KEY=

# Model used to score attacks in two-player games.
JUDGE_MODEL=claude-sonnet-5

# Local background-removal service (rembg). Port 8788 rather than rembg's own
# default of 7000, which on macOS is taken by AirPlay Receiver — it accepts the
# connection and never answers, so the request simply hangs.
# Set up with `npm run setup:cutout`
# and started by `npm run dev`. Preferred over Remove.bg when present: no
# quota, no per-image cost, and nothing leaves the machine.
REMBG_URL=http://127.0.0.1:8788
